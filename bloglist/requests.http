# @name createUser
POST http://localhost:3003/api/users
Content-Type: application/json

{
  "username": "exampleuser",
  "name": "Example User",
  "password": "replace-with-a-local-test-password"
}

###
# @name login
POST http://localhost:3003/api/login
Content-Type: application/json

{
  "username": "exampleuser",
  "password": "replace-with-a-local-test-password"
}

###
# @name createBlog
# Creeaza blogul folosind tokenul primit la login
POST http://localhost:3003/api/blogs
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "title": "Primul meu blog legat de user",
  "author": "Example Author",
  "url": "https://fullstackopen.com",
  "likes": 5
}

###
# Verifica in lista ca blogul a fost creat si asociat userului logat
GET http://localhost:3003/api/blogs
Authorization: Bearer {{login.response.body.token}}

###
# Sterge blogul creat mai sus, folosind ID-ul din raspunsul POST
DELETE http://localhost:3003/api/blogs/{{createBlog.response.body.id}}
Authorization: Bearer {{login.response.body.token}}
